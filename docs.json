{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "modal-devin",
  "description": "Run secure, resumable Devin Outposts workers on Modal.",
  "colors": {
    "primary": "#09AF58",
    "light": "#80EE64",
    "dark": "#09AF58"
  },
  "logo": {
    "light": "/assets/modal-logo-light.svg",
    "dark": "/assets/modal-logo-dark.svg",
    "href": "/"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#161616"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "icon": "house",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Tutorials",
        "icon": "graduation-cap",
        "pages": [
          "tutorials/first-worker",
          "tutorials/create-an-outpost",
          "tutorials/custom-workspace"
        ]
      },
      {
        "group": "How-to guides",
        "icon": "screwdriver-wrench",
        "pages": [
          "guides/customize-image",
          "guides/resources-and-regions",
          "guides/runtime-configuration",
          "guides/multiple-outposts",
          "guides/operate-a-worker",
          "guides/troubleshooting"
        ]
      },
      {
        "group": "Concepts",
        "icon": "lightbulb",
        "pages": [
          "explanation/architecture",
          "explanation/resumability",
          "explanation/security",
          "explanation/session-lifecycle",
          "explanation/timeouts"
        ]
      },
      {
        "group": "Reference",
        "icon": "book-open",
        "pages": [
          "reference/cli",
          "reference/worker",
          "reference/settings",
          "reference/images",
          "reference/exceptions",
          "reference/generated-application"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Devin Outposts",
        "href": "https://docs.devin.ai/cloud/outposts/overview"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/modal-labs/modal-devin"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/modal-labs/modal-devin"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/modal-labs/modal-devin"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  }
}
